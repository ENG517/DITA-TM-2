<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="Rotating_an_image">
  <title>Rotating an image</title>
  <shortdesc>You can rotate an image in Figma by selecting it and dragging the rotation handle or by inputting an angle value.</shortdesc>
  <taskbody>
    <steps>
      <step>
        <cmd>Select your image.</cmd>
      </step>
      <step>
        <cmd>
          Navigate to the the rotation field in the design panel, which should have an angle icon next to it.
        </cmd>
        <!-- LINDGREN:
          - Moved the image to a stepxmp, wherein you should provide
            an alt description in this case.
          - Also, it's helpful to provide highlighted overlays to
            indicate which part of the screenshot is important.
          - Remember that the alt attribute should be present
            no matter what, even if it is empty. This signals
            a11y tech that it is decorative.
        -->
        <stepxmp>
          <image href="../assets/images/Rotation_Tool.png" alt=""></image>
        </stepxmp>
      </step>
      <step>
        <cmd>Enter your desired degree value.</cmd>
      </step>
    </steps>
  </taskbody>
</task>